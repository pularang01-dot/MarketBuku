# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payment: "midtrans" (sandbox/production) or "mock" (development ONLY, refused in production) ---
PAYMENT_PROVIDER=mock
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_SANDBOX=true

# --- Shipping: "dev" (development-only flat rates) ---
SHIPPING_PROVIDER=dev
SHIPPING_API_KEY=

# --- Email: "console" (logs only, development) ---
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=noreply@example.com

# --- Optional distributed rate limiting (Upstash Redis REST) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Shipping "biteship" ---
SHIPPING_ORIGIN_POSTAL_CODE=
SHIPPING_COURIERS=jne,sicepat,jnt
